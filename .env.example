# Cloudflare D1 (production database). D1 has no direct connection string --
# these point at the authenticated proxy Worker in cf-worker/ instead. When
# both are set, D1 takes priority over DATABASE_URL below.
D1_PROXY_URL=
D1_PROXY_AUTH_TOKEN=

# Supabase / Cloud Database Configuration (alternative to D1)
# Paste your Supabase Database Connection String below (from Supabase Settings -> Database -> Connection String (URI))
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Leave everything above and below blank to fall back to local SQLite (data/cars.db).

DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# OTTO AI Inspection Assistant (local Ollama, no API key needed)
# OLLAMA_HOST: where the Ollama server lives. Point this at 127.0.0.1:11434 once
# the app runs on the same machine as Ollama; use the LAN/Tailscale IP otherwise.
OLLAMA_HOST=http://100.81.169.48:11434
OLLAMA_MODEL=qwen3-vl:8b
